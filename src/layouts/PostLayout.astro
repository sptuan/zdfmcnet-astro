---
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';

export interface Props {
  title: string;
  date: string;
  categories?: string[];
  tags?: string[];
  thumbnail?: string;
  postId: number;
}

const { title, date, categories, tags, thumbnail, postId } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout title={title}>
  <div class="article-layout py-12 md:py-20">

    <!-- LEFT SIDEBAR: sticky, desktop only -->
    <aside class="article-meta">
      <img class="article-meta__avatar" src="https://static.zdfmc.net/zdfmc_net/wp-content/uploads/2024/10/cropped-Snipaste_2024-10-17_22-54-48.png" alt="周大服小编" />
      <div class="article-meta__author">周大服小编114514号</div>
      <time datetime={date} class="article-meta__date">{formattedDate}</time>

      {categories && categories.length > 0 && (
        <>
          <div class="article-meta__section-title">分类</div>
          <div class="article-meta__categories">
            {categories.map(cat => (
              <a href={`/p/category/${cat}`} class="article-meta__category">{cat}</a>
            ))}
          </div>
        </>
      )}

      {tags && tags.length > 0 && (
        <>
          <div class="article-meta__section-title">标签</div>
          <div class="article-meta__tags">
            {tags.map(tag => (
              <span class="article-meta__tag">#{tag}</span>
            ))}
          </div>
        </>
      )}
    </aside>

    <!-- CENTER: article content -->
    <div>
      <!-- Mobile/tablet: inline meta bar -->
      <div class="article-meta-inline">
        <img class="article-meta__avatar" src="https://static.zdfmc.net/zdfmc_net/wp-content/uploads/2024/10/cropped-Snipaste_2024-10-17_22-54-48.png" alt="周大服小编" />
        <span class="article-meta__author">周大服小编114514号</span>
        <time datetime={date}>{formattedDate}</time>
        {categories && categories.length > 0 && (
          <span>{categories.join(' · ')}</span>
        )}
      </div>

      <!-- Title -->
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight mb-6 max-w-article mx-auto">
        {title}
      </h1>

      <!-- Mobile/tablet: collapsible TOC -->
      {/*
        TOC is built client-side; this details element provides the shell
        and is hidden on desktop
      */}
      <details class="article-toc-mobile max-w-article mx-auto">
        <summary>目录</summary>
        <nav id="toc-mobile-list"></nav>
      </details>

      <!-- Featured image — restrained -->
      {thumbnail && (
        <figure class="article-thumbnail">
          <img src={thumbnail} alt={title} loading="lazy" />
        </figure>
      )}

      <!-- Article body -->
      <div class="prose-article" id="article-body">
        <slot />
      </div>

      <!-- Comments -->
      <div class="max-w-article mx-auto">
        <Comments postId={postId} />
      </div>
    </div>

    <!-- RIGHT SIDEBAR: TOC, desktop only -->
    <aside class="article-toc">
      <div class="article-toc__title">目录</div>
      <nav>
        <ul class="article-toc__list" id="toc-list"></ul>
      </nav>
    </aside>

  </div>
</BaseLayout>

<script>
  // Build table of contents from article headings
  function buildTOC() {
    const article = document.getElementById('article-body');
    if (!article) return;

    const headings = article.querySelectorAll('h2, h3');
    if (headings.length < 2) return;

    const tocList = document.getElementById('toc-list');
    const tocMobileList = document.getElementById('toc-mobile-list');
    if (!tocList && !tocMobileList) return;

    // Build TOC HTML and assign heading IDs
    const items: Array<{ id: string; text: string; level: number; el: Element }> = [];

    headings.forEach((h, i) => {
      const id = h.id || `heading-${i}`;
      if (!h.id) h.id = id;
      items.push({
        id,
        text: h.textContent || '',
        level: parseInt(h.tagName[1]),
        el: h,
      });
    });

    const html = items.map(item =>
      `<li class="article-toc__item${item.level === 3 ? ' article-toc__item--h3' : ''}">
        <a href="#${item.id}">${item.text}</a>
      </li>`
    ).join('');

    if (tocList) tocList.innerHTML = html;
    if (tocMobileList) {
      const ul = document.createElement('ul');
      ul.className = 'article-toc__list';
      ul.innerHTML = html;
      tocMobileList.innerHTML = '';
      tocMobileList.appendChild(ul);
    }

    // IntersectionObserver to highlight active heading
    const tocItems = document.querySelectorAll('.article-toc__item');
    if (tocItems.length === 0) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const idx = items.findIndex(it => it.el === entry.target);
        if (idx === -1) return;

        if (entry.isIntersecting) {
          tocItems.forEach(t => t.classList.remove('article-toc__item--active'));
          // Highlight all matching TOC items (desktop + mobile)
          const targetId = items[idx].id;
          document.querySelectorAll(`.article-toc__item a[href="#${targetId}"]`).forEach(a => {
            a.closest('.article-toc__item')?.classList.add('article-toc__item--active');
          });
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });

    headings.forEach(h => observer.observe(h));
  }

  buildTOC();
</script>
