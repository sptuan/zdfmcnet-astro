---
import BaseLayout from '../layouts/BaseLayout.astro';
import pagesData from '../data/wordpress_data.json';

export function getStaticPaths() {
  // Generate paths for all published pages with slugs
  return pagesData.pages
    .filter((p: any) => p.slug && p.title !== '示例页面' && p.title !== 'Sample Page')
    .map((page: any) => ({
      params: { slug: page.slug },
      props: { page },
    }));
}

const { page } = Astro.props;
---

<BaseLayout title={page.title}>
  <div class="container-main py-12 md:py-20">
    <article>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-text-primary mb-8">
        {page.title}
      </h1>
      <div class="prose prose-lg max-w-none
        prose-headings:text-text-primary prose-headings:font-display
        prose-a:text-accent prose-a:no-underline hover:prose-a:text-accent-warm
        prose-img:rounded-xl prose-img:shadow-lg
        prose-blockquote:border-accent prose-blockquote:text-text-secondary
        prose-hr:border-gray-200
      ">
        <Fragment set:html={page.content} />
      </div>
    </article>
  </div>
</BaseLayout>
