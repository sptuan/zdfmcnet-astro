---
import BaseLayout from '../layouts/BaseLayout.astro';
import Comments from '../components/Comments.astro';
import pagesData from '../data/wordpress_data.json';

export function getStaticPaths() {
  return pagesData.pages
    .filter((p: any) => p.slug && p.title !== '示例页面' && p.title !== 'Sample Page')
    .map((page: any) => ({
      params: { slug: page.slug },
      props: { page },
    }));
}

const { page } = Astro.props;
---

<BaseLayout title={page.title}>
  <div class="container-main py-12 md:py-20">
    <article>
      <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-8 max-w-article mx-auto">
        {page.title}
      </h1>
      <div class="prose-article">
        <Fragment set:html={page.content} />
      </div>
    </article>
    <Comments postId={page.id} />
  </div>
</BaseLayout>
