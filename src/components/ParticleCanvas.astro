---
// Lightweight particle background — 200 particles, canvas arc rendering
---
<canvas id="particle-canvas" class="absolute inset-0 pointer-events-none z-0" style="opacity:0;transition:opacity 1.5s ease-in"></canvas>

<script>
  const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  let animId = 0;
  let running = false;

  const N = 200;
  const MOUSE_RADIUS = 260;
  const MOUSE_FORCE = 0.04;

  type Particle = {
    x: number; y: number; bx: number; by: number;
    vx: number; vy: number; r: number; alpha: number;
    color: string;
  };
  const particles: Particle[] = [];
  const colors = [
    'rgba(8,145,178,__A__)',
    'rgba(8,145,178,__A__)',
    'rgba(8,145,178,__A__)',
    'rgba(229,92,74,__A__)',
    'rgba(212,149,50,__A__)',
  ];

  let mouse = { x: -1000, y: -1000 };
  let w = 0, h = 0;
  let initialized = false;
  let startTime = 0;

  function edgeBiased() {
    const r = Math.random();
    return r < 0.5 ? r * r * 2 : 1 - (1 - r) * (1 - r) * 2;
  }

  function init() {
    particles.length = 0;
    for (let i = 0; i < N; i++) {
      particles.push({
        x: edgeBiased() * w, y: edgeBiased() * h,
        bx: edgeBiased() * w, by: edgeBiased() * h,
        vx: 0, vy: 0,
        r: Math.random() * 2 + 1.2,
        alpha: Math.random() * 0.22 + 0.05,
        color: colors[Math.floor(Math.random() * colors.length)],
      });
    }
  }

  function resize() {
    const rect = canvas.parentElement!.getBoundingClientRect();
    w = canvas.width = rect.width;
    h = canvas.height = rect.height;
    init();
  }

  function draw(ts: number) {
    if (!running) { animId = requestAnimationFrame(draw); return; }
    if (!startTime) startTime = ts;
    const elapsed = ts - startTime;

    ctx.clearRect(0, 0, w, h);

    const mr = MOUSE_RADIUS, mf = MOUSE_FORCE;
    const mx = mouse.x, my = mouse.y;

    for (let i = 0; i < N; i++) {
      const p = particles[i];

      if (initialized) {
        const dx = p.x - mx, dy = p.y - my;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < mr && dist > 0) {
          const f = (mr - dist) / mr * mf;
          p.vx += (dx / dist) * f;
          p.vy += (dy / dist) * f;
        }
      }

      const ps = initialized ? 0.0005 : 0.008;
      p.vx += (p.bx - p.x) * ps;
      p.vy += (p.by - p.y) * ps;
      p.vx *= 0.97; p.vy *= 0.97;
      p.x += p.vx; p.y += p.vy;

      // Render using GPU-accelerated arc fill
      const alpha = initialized ? p.alpha : p.alpha * Math.min(elapsed / 1800, 1);
      ctx.fillStyle = p.color.replace('__A__', String(alpha));
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
    }

    if (!initialized && elapsed > 1800) initialized = true;
    animId = requestAnimationFrame(draw);
  }

  // IntersectionObserver to pause when off-screen
  const observer = new IntersectionObserver((entries) => {
    running = entries[0].isIntersecting;
  }, { threshold: 0 });
  observer.observe(canvas.parentElement!);

  setTimeout(() => { canvas.style.opacity = '1'; }, 100);

  canvas.parentElement?.addEventListener('mousemove', (e: Event) => {
    const me = e as MouseEvent;
    const rect = canvas.parentElement!.getBoundingClientRect();
    mouse.x = me.clientX - rect.left;
    mouse.y = me.clientY - rect.top;
  });
  canvas.parentElement?.addEventListener('mouseleave', () => { mouse.x = -1000; mouse.y = -1000; });
  window.addEventListener('resize', resize);
  resize();
  animId = requestAnimationFrame(draw);
</script>
