---
const stats = [
  { icon: '⏰', value: '2012年6月', label: '起始于' },
  { icon: '🌍', value: '20+', label: '最大活跃人数' },
  { icon: '⚙️', value: '12周目', label: '已持续' },
];
---

<section id="stats" class="section-padding bg-surface-light/20 border-y border-gray-200">
  <div class="container-main">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-white">一些不起眼的数据</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {stats.map(stat => (
        <div class="glass-card p-8 text-center group hover:border-accent/20 transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl mb-4">{stat.icon}</div>
          <div class="text-3xl md:text-4xl font-black text-white mb-2 tracking-tight">
            {stat.value}
          </div>
          <div class="text-text-muted text-sm font-medium uppercase tracking-wider">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
