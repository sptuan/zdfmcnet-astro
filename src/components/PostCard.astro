---
export interface Props {
  id: number;
  title: string;
  date: string;
  excerpt?: string;
  categories?: string[];
  thumbnail?: string;
}

const { id, title, date, excerpt, categories, thumbnail } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<article class="glass-card overflow-hidden group">
  <a href={`/p/${id}`} class="block p-5 md:p-6">
    {thumbnail && (
      <div class="mb-4 -mx-5 -mt-5 md:-mx-6 md:-mt-6 overflow-hidden rounded-t-2xl">
        <img src={thumbnail} alt={title} class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
      </div>
    )}

    {categories && categories.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-2.5">
        {categories.slice(0, 2).map(cat => (
          <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-accent/10 text-accent">
            {cat}
          </span>
        ))}
      </div>
    )}

    <h3 class="text-text-primary font-semibold text-base md:text-lg leading-snug mb-2 group-hover:text-accent transition-colors line-clamp-2">
      {title}
    </h3>

    {excerpt && (
      <p class="text-text-muted text-sm leading-relaxed line-clamp-2 mb-3">
        {excerpt}
      </p>
    )}

    <time datetime={date} class="text-text-secondary font-medium text-xs">
      {formattedDate}
    </time>
  </a>
</article>
